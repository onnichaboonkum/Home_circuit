    },
    {
      "start": 26.75,
      "duration": 2.6,
      "style": "lower",
      "lines": [
        "เริ่มจากปัญหาที่เจอจริง"
      ]
    },
    {
      "start": 29.75,
      "duration": 2.6,
      "style": "lower",
      "lines": [
        "ออกแบบวงจร และลายวงจร (PCB)"
