  "voiceover": [
    {
      "id": "vo01",
      "start": 0.65,
      "duration": 3.6676458333333333,
      "text": "เทคโนโลยีหลายชิ้นของเรา ไม่ได้เริ่มต้นจากโรงงานใหญ่"
    },
    {
      "id": "vo02",
      "start": 4.75,
      "duration": 2.2836041666666667,
      "text": "แต่มันเริ่มจากบ้านหลังหนึ่ง"
    },
    {
      "id": "vo03",
      "start": 8.1,
      "duration": 6.523520833333333,
      "text": "Home Circuit เริ่มต้นจากกลุ่มวิศวกรไฟฟ้าและเมคคาทรอนิกส์ ที่มีประสบการณ์จากการทำงานในบริษัท"
    },
    {
      "id": "vo04",
      "start": 14.799999999999999,
      "duration": 2.50825,
      "text": "และมีความคิดง่าย ๆ เหมือนกันว่า"
    },
    {
      "id": "vo05",
      "start": 17.599999999999998,
      "duration": 4.1280833333333335,
      "text": "ถ้าอุปกรณ์ที่เราต้องการยังไม่มี ทำไมเราไม่สร้างมันขึ้นมาเอง?"
    },
    {
      "id": "vo06",
      "start": 25.0,
      "duration": 8.753708333333334,
      "text": "จากการทดลองทำอุปกรณ์เพื่อใช้งานกันเอง ค่อย ๆ กลายเป็นงานพัฒนา Hardware และ Firmware ที่เริ่มต้นจากปัญหาในการใช้งานจริง"
    },
    {
      "id": "vo07",
      "start": 42.3,
      "duration": 3.8259583333333333,
      "text": "จากงาน Freelance เล็ก ๆ โปรเจกต์เริ่มเดินทางไปไกลขึ้น"
    },
    {
      "id": "vo08",
      "start": 46.7,
      "duration": 9.184708333333333,
      "text": "ตั้งแต่งาน IoT และระบบควบคุม งานพัฒนาโดรน เทคโนโลยีสำหรับหน่วยงานภาครัฐ ไปจนถึงโปรเจกต์ของนักศึกษามหาวิทยาลัย"
    },
    {
      "id": "vo09",
      "start": 61.4,
      "duration": 4.362833333333334,
      "text": "แต่สิ่งที่ Home Circuit อยากสร้าง ไม่ใช่แค่อุปกรณ์หนึ่งชิ้นที่ใช้งานได้"
    },
    {
      "id": "vo10",
      "start": 66.0,
      "duration": 7.846520833333333,
      "text": "เราอยากสร้าง Hardware ที่นักพัฒนาสามารถนำไปต่อยอด ประยุกต์ใช้ และเขียนโปรแกรมเพิ่มเติมให้เหมาะกับงานของตัวเองได้"
    },
    {
      "id": "vo11",
      "start": 98.3,
      "duration": 4.153708333333333,
      "text": "เพราะสำหรับ Home Circuit เทคโนโลยีไม่ได้เริ่มจากคำว่า “ขายอะไร”"
    },
    {
      "id": "vo12",
      "start": 102.95,
      "duration": 1.3572291666666667,
      "text": "แต่มันเริ่มจาก…"
    },
    {
      "id": "vo13",
      "start": 104.9,
      "duration": 2.099645833333333,
      "text": "“เราจะแก้ปัญหานี้ได้อย่างไร”"
    },
    {
      "id": "vo14",
      "start": 107.6,
      "duration": 3.972375,
      "text": "และเปลี่ยนคำตอบนั้น ให้กลายเป็น Hardware ที่ใช้งานได้จริง"
    }
  ]
}