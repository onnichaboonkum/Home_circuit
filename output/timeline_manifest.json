    {
      "start": 0.6,
      "duration": 4.5,
      "style": "lower",
      "lines": [
        "เทคโนโลยีหลายชิ้นของเรา",
        "ไม่ได้เริ่มต้นจากโรงงานใหญ่"
      ]
    },
    {
      "start": 5.7,
      "duration": 2.6,
      "style": "under",
      "lines": [
        "แต่มันเริ่มจาก “บ้านหลังหนึ่ง”"
      ]
    },
    {
      "start": 8.6,
      "duration": 3.35,
      "style": "lower",
      "lines": [
        "Home Circuit เริ่มต้นที่บ้านหลังเล็ก ๆ"
      ]
    },
    {
      "start": 12.15,
      "duration": 4.35,
      "style": "lower",
      "lines": [
        "กลุ่มวิศวกรไฟฟ้าและเมคคาทรอนิกส์",
        "ที่เคยทำงานในบริษัทมาก่อน"
      ]
    },
    {
      "start": 16.7,
      "duration": 2.8,
      "style": "lower",
      "lines": [
        "และทุกคนคิดเหมือนกันว่า…"
      ]
    },
    {
      "start": 19.7,
      "duration": 4.25,
      "style": "lower",
      "lines": [
        "“ถ้าอุปกรณ์ที่ต้องการยังไม่มี",
        "ทำไมไม่สร้างเองล่ะ?”"
      ]
    },
    {
      "start": 24.4,
      "duration": 2.1,
      "style": "lower",
      "lines": [
        "ก็สร้างขึ้นมาเองเลย"
